JWT_SECRET=replace-with-32-byte-random-secret
DB_PASSWORD=replace-with-strong-postgres-password
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password

API_DOMAIN=mail-api.deepcanvas.ai
DASHBOARD_DOMAIN=mail.deepcanvas.ai
LANDING_DOMAIN=mail-www.deepcanvas.ai
WIKI_DOMAIN=mail-docs.deepcanvas.ai
SMTP_DOMAIN=smtp.deepcanvas.ai
USE_HTTPS=true

AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=replace-with-ses-access-key
AWS_SES_SECRET_ACCESS_KEY=replace-with-ses-secret
SES_CONFIGURATION_SET=plunk-tracking

S3_PUBLIC_URL=https://mail-api.deepcanvas.ai/uploads
DISABLE_SIGNUPS=true
VERIFY_EMAIL_ON_SIGNUP=true
EMAIL_RATE_LIMIT_PER_SECOND=1

PLUNK_HTTP_PORT=8088
PLUNK_SMTPS_PORT=465
PLUNK_SMTP_PORT=587
