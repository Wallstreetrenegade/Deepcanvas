FROM node:20-bookworm-slim AS web-build

WORKDIR /app

COPY jiuwenclaw/package*.json ./jiuwenclaw/
COPY jiuwenclaw/scripts ./jiuwenclaw/scripts
COPY jiuwenclaw/resources ./jiuwenclaw/resources
COPY jiuwenclaw/web ./jiuwenclaw/web

WORKDIR /app/jiuwenclaw
RUN npm ci

WORKDIR /app/jiuwenclaw/web
ARG VITE_CESDK_LICENSE=""
ENV VITE_CESDK_LICENSE=${VITE_CESDK_LICENSE}
RUN npm ci && npm run build


FROM node:24-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/var/data \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && python3 -m venv /opt/venv

RUN mkdir -p /var/data

COPY . /app
COPY --from=web-build /app/jiuwenclaw/web/dist /app/jiuwenclaw/web/dist

RUN cd packages/open-design && pnpm install --frozen-lockfile
RUN pip install --upgrade pip && pip install .

EXPOSE 10000

CMD ["python", "-m", "jiuwenclaw.render_entry"]
